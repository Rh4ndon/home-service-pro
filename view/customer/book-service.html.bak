<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Book Service - HomeService Pro</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../shared.css" />
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-text">HomeService<span>Pro</span></div>
      <div class="brand-sub">Customer Portal</div>
    </div>
    <nav class="sidebar-nav">
      <div class="sidebar-section">
        <div class="sidebar-section-label">Main Menu</div>
        <a href="dashboard.html" class="sidebar-link">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Dashboard
        </a>
        <a href="book-service.html" class="sidebar-link active">
          <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="12" y1="14" x2="12" y2="18"/><line x1="10" y1="16" x2="14" y2="16"/></svg>
          Book Service
        </a>
        <a href="my-tickets.html" class="sidebar-link">
          <svg viewBox="0 0 24 24"><path d="M15 5v2"/><path d="M15 11v2"/><path d="M15 17v2"/><rect x="3" y="4" width="18" height="16" rx="2"/></svg>
          My Tickets
        </a>
        <a href="my-appliances.html" class="sidebar-link">
          <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          My Appliances
        </a>
        <a href="chat.html" class="sidebar-link">
          <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Messages
        </a>
        <a href="profile.html" class="sidebar-link">
          <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Profile
        </a>
      </div>
      </nav>
    <div class="sidebar-user">
      <div class="sidebar-avatar">JD</div>
      <div class="sidebar-user-info">
        <div class="sidebar-user-name">Juan Dela Cruz</div>
        <div class="sidebar-user-role">Customer</div>
      </div>
      <button class="sidebar-logout" onclick="openModal('logoutModal')" title="Log Out">
        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      </button>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    <div class="page-header">
      <div>
        <h1>Book a Service</h1>
        <p>Choose a registered appliance or add a new one to schedule a repair appointment.</p>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <form id="bookingForm" onsubmit="return false;">
          <div class="form-group">
            <label for="applianceSelect">Select Your Appliance</label>
            <select id="applianceSelect">
              <option value="">Choose an appliance...</option>
              <option value="new">Add a new / other appliance...</option>
            </select>
            <p style="font-size:0.8rem;color:var(--muted);margin-top:6px;">Pick from your registered appliances, or choose "Add a new / other appliance" to enter details manually.</p>
          </div>

          <div id="newApplianceFields" style="display:none;">
            <div class="grid-2">
              <div class="form-group">
                <label for="applianceType">Appliance Type</label>
                <select id="applianceType">
                  <option value="">Select appliance type...</option>
                  <option value="refrigerator">Refrigerator</option>
                  <option value="washing-machine">Washing Machine</option>
                  <option value="air-conditioner">Air Conditioner</option>
                  <option value="microwave">Microwave</option>
                  <option value="oven">Oven / Stove</option>
                  <option value="dishwasher">Dishwasher</option>
                  <option value="electric-fan">Electric Fan</option>
                  <option value="water-heater">Water Heater</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="form-group">
                <label for="applianceName">Appliance Name</label>
                <input type="text" id="applianceName" placeholder="e.g. Samsung RT38 Refrigerator" />
              </div>
            </div>

            <div class="grid-2">
              <div class="form-group">
                <label for="makeBrand">Make / Brand</label>
                <input type="text" id="makeBrand" placeholder="e.g. Samsung, LG, Panasonic" />
              </div>
              <div class="form-group">
                <label for="yearModel">Year</label>
                <input type="number" id="yearModel" placeholder="e.g. 2022" min="1990" max="2026" />
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="issueDesc">Issue Description</label>
            <textarea id="issueDesc" placeholder="Describe the problem you're experiencing with the appliance..."></textarea>
          </div>

          <div class="form-group">
            <label for="detailedReport">Detailed Report <span style="font-weight:400;color:var(--muted);font-size:0.85rem;">(optional)</span></label>
            <textarea id="detailedReport" rows="5" placeholder="Provide any additional details, error messages, symptoms, or observations that may help the repairman diagnose the issue..."></textarea>
            <p style="font-size:0.78rem;color:var(--muted);margin-top:4px;">Include things like: error codes, unusual sounds, when the problem started, troubleshooting steps already tried, etc.</p>
          </div>

          <!-- BOOKING MEDIA: 3 PHOTOS + 1 VIDEO -->
          <div class="form-group">
            <label>Photos &amp; Video of the Issue <span style="color:#ef4444;font-weight:700;">*</span>
              <span style="font-weight:400;color:var(--muted);font-size:0.82rem;">Required — capture 3 photos and 1 short video so the repairman can see the problem.</span>
            </label>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-top:10px;">
              <div class="hs-media-slot" id="imgSlot1" data-slot="img1">
                <div class="hs-media-preview" style="border:2px dashed var(--line);border-radius:12px;height:130px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;cursor:pointer;background:var(--panel);overflow:hidden;position:relative;">
                  <div class="hs-media-empty">&#128247;<br><span style="font-size:0.78rem;color:var(--muted);">Photo 1</span></div>
                  <input type="file" accept="image/*" class="hs-img-input" data-slot="img1" style="display:none;">
                </div>
                <div style="display:flex;gap:6px;margin-top:8px;">
                  <button type="button" class="btn btn-sm btn-secondary hs-cam-btn" data-slot="img1" style="flex:1;">Camera</button>
                  <button type="button" class="btn btn-sm btn-secondary hs-file-btn" data-slot="img1" style="flex:1;">Gallery</button>
                </div>
              </div>
              <div class="hs-media-slot" id="imgSlot2" data-slot="img2">
                <div class="hs-media-preview" style="border:2px dashed var(--line);border-radius:12px;height:130px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;cursor:pointer;background:var(--panel);overflow:hidden;position:relative;">
                  <div class="hs-media-empty">&#128247;<br><span style="font-size:0.78rem;color:var(--muted);">Photo 2</span></div>
                  <input type="file" accept="image/*" class="hs-img-input" data-slot="img2" style="display:none;">
                </div>
                <div style="display:flex;gap:6px;margin-top:8px;">
                  <button type="button" class="btn btn-sm btn-secondary hs-cam-btn" data-slot="img2" style="flex:1;">Camera</button>
                  <button type="button" class="btn btn-sm btn-secondary hs-file-btn" data-slot="img2" style="flex:1;">Gallery</button>
                </div>
              </div>
              <div class="hs-media-slot" id="imgSlot3" data-slot="img3">
                <div class="hs-media-preview" style="border:2px dashed var(--line);border-radius:12px;height:130px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;cursor:pointer;background:var(--panel);overflow:hidden;position:relative;">
                  <div class="hs-media-empty">&#128247;<br><span style="font-size:0.78rem;color:var(--muted);">Photo 3</span></div>
                  <input type="file" accept="image/*" class="hs-img-input" data-slot="img3" style="display:none;">
                </div>
                <div style="display:flex;gap:6px;margin-top:8px;">
                  <button type="button" class="btn btn-sm btn-secondary hs-cam-btn" data-slot="img3" style="flex:1;">Camera</button>
                  <button type="button" class="btn btn-sm btn-secondary hs-file-btn" data-slot="img3" style="flex:1;">Gallery</button>
                </div>
              </div>
              <div class="hs-media-slot" id="vidSlot" data-slot="vid">
                <div class="hs-media-preview" style="border:2px dashed var(--line);border-radius:12px;height:130px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;cursor:pointer;background:var(--panel);overflow:hidden;position:relative;">
                  <div class="hs-media-empty">&#127909;<br><span style="font-size:0.78rem;color:var(--muted);">Video (short)</span></div>
                  <input type="file" accept="video/*" class="hs-vid-input" data-slot="vid" style="display:none;">
                </div>
                <div style="display:flex;gap:6px;margin-top:8px;">
                  <button type="button" class="btn btn-sm btn-secondary hs-vid-cam-btn" data-slot="vid" style="flex:1;">Camera</button>
                  <button type="button" class="btn btn-sm btn-secondary hs-vid-file-btn" data-slot="vid" style="flex:1;">Gallery</button>
                </div>
              </div>
            </div>
            <p id="mediaStatus" style="font-size:0.8rem;color:var(--muted);margin-top:8px;"></p>
          </div>

          <div class="grid-2">
            <div class="form-group">
              <label for="preferredDate">Preferred Date</label>
              <input type="date" id="preferredDate" />
            </div>
            <div class="form-group">
              <label for="preferredTime">Preferred Time</label>
              <input type="time" id="preferredTime" />
            </div>
          </div>

        </form>
      </div>

      <!-- CLIENT LOCATION FOR BOOKING -->
      <div class="card">
        <div class="card-header"><h2>Your Location</h2></div>
        <div class="card-body">
          <p style="font-size:0.85rem;color:var(--muted);margin-bottom:12px;">Set your address to find nearby repairmen. You can pick from map, search, or use device location.</p>
          <div class="hs-location-picker">
            <div class="hs-map-wrap">
              <div class="hs-map-canvas" id="bookingMap"></div>
              <div class="hs-search-bar">
                <div class="hs-search-bar-inner">
                  <input type="text" id="bookingAddressSearch" placeholder="Search your address..." autocomplete="off" />
                  <button type="button" class="hs-locate-btn" id="bookingLocateBtn">&#9672; Use my location</button>
                </div>
              </div>
            </div>
            <input type="hidden" id="bookingLat" />
            <input type="hidden" id="bookingLng" />
            <input type="hidden" id="bookingAddress" />
            <div class="hs-location-status" id="bookingLocationStatus">Set your location using the map, search, or device location.</div>
          </div>
        </div>
      </div>

      <!-- SEARCH REPAIRMEN -->
      <div class="card">
        <div class="card-header">
          <h2>Find Nearby Repairmen</h2>
        </div>
        <div class="card-body">
          <div class="form-group" style="max-width:420px;">
            <label for="searchRadius">Search radius: <strong id="searchRadiusLabel">10 km</strong></label>
            <input type="range" id="searchRadius" min="10" max="30" step="1" value="10" oninput="document.getElementById('searchRadiusLabel').textContent=this.value+' km';" />
            <small style="color:var(--muted);font-size:0.8rem;">Shows available repairmen within this driving distance from your address.</small>
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;">
            <button class="btn btn-primary" id="findRepairmenBtn">
              <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              Find Nearby Repairmen
            </button>
            <span id="findRepairmenStatus" style="display:inline-flex;align-items:center;font-size:0.88rem;color:var(--muted);"></span>
          </div>
        </div>
      </div>

      <!-- REPAIRMAN RESULTS (hidden until search) -->
      <div id="repairmanResultsSection" style="display:none;">
        <div class="card">
          <div class="card-header">
            <h2 id="repairmanResultsHeader">Available Repairmen</h2>
          </div>
          <div class="card-body" style="padding:0;">
            <div style="display:flex;gap:0;flex-wrap:wrap;min-height:320px;">
              <div id="repairmanMap" style="flex:1 1 520px;height:380px;"></div>
              <div id="repairmanList" style="flex:1 1 300px;max-height:420px;overflow-y:auto;padding:16px;"></div>
            </div>
            <div style="padding:14px 16px;border-top:1px solid var(--line);display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
              <span style="font-size:0.88rem;color:var(--muted);">Selected repairman:</span>
              <span id="selectedRepairmanDisplay" style="font-weight:700;color:var(--text);">None</span>
              <input type="hidden" id="selectedRepairmanId" />
              <input type="hidden" id="selectedRepairmanDist" />
              <input type="hidden" id="selectedRepairmanDur" />
            </div>
          </div>
        </div>
      </div>

      <!-- SUBMIT SECTION -->
      <div class="card" id="submitSection" style="margin-top:0;">
        <div class="card-body" style="display:flex; gap:12px; justify-content:flex-end;">
          <a href="dashboard.html" class="btn btn-secondary">Cancel</a>
          <button type="button" class="btn btn-primary" id="submitBookingBtn" onclick="handleSubmitBookingClick()" disabled title="Please find nearby repairmen first.">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Submit Booking
          </button>
        </div>
      </div>

  </main>

  <!-- CONFIRM BOOKING MODAL -->
  <div class="modal-overlay" id="confirmBookingModal">
    <div class="modal">
      <div class="modal-header">
        <h3>Confirm Booking</h3>
        <button class="modal-close" onclick="closeModal('confirmBookingModal')">&times;</button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to submit this service booking? You will be able to track the status from your dashboard.</p>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary btn-cancel" onclick="closeModal('confirmBookingModal')">Cancel</button>
        <button class="btn btn-primary" id="confirmBtn">Confirm</button>
      </div>
    </div>
  </div>

  <!-- SUCCESS BOOKING MODAL -->
  <div class="modal-overlay" id="successBookingModal">
    <div class="modal">
      <div class="modal-header">
        <h3>Booking Submitted</h3>
        <button class="modal-close" onclick="closeModal('successBookingModal')">&times;</button>
      </div>
      <div class="modal-body">
        <p>Your service booking has been submitted successfully! Our team will review your request and assign a technician shortly.</p>
      </div>
      <div class="modal-footer">
        <a href="dashboard.html" class="btn btn-primary" onclick="closeModal('successBookingModal')">Go to Dashboard</a>
      </div>
    </div>
  </div>

  <!-- Logout Modal -->
  <div class="modal-overlay" id="logoutModal">
    <div class="modal">
      <div class="modal-header">
        <h3>Log Out</h3>
        <button class="modal-close" onclick="closeModal('logoutModal')">&times;</button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to log out of your account?</p>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary btn-cancel" onclick="closeModal('logoutModal')">Cancel</button>
        <button class="btn btn-danger" id="logoutBtn">Log Out</button>
      </div>
    </div>
  </div>

  <script src="../shared.js"></script>
  <script src="../location-picker.js"></script>
  <script>
  (function() {
    if (!localStorage.getItem('is_logged_in')) { window.location.href = 'login.html'; return; }
    var userId = localStorage.getItem('id');
    var userName = localStorage.getItem('name');
    var allAppliances = [];
    var TYPE_LABELS = {
      'refrigerator': 'Refrigerator',
      'washing-machine': 'Washing Machine',
      'air-conditioner': 'Air Conditioner',
      'microwave': 'Microwave',
      'oven': 'Oven / Stove',
      'dishwasher': 'Dishwasher',
      'electric-fan': 'Electric Fan',
      'water-heater': 'Water Heater',
      'other': 'Other'
    };
    var sidebarUserName = document.querySelector('.sidebar-user-name');
    var sidebarAvatar = document.querySelector('.sidebar-avatar');
    if (sidebarUserName) sidebarUserName.textContent = userName || 'Customer';
    if (sidebarAvatar) sidebarAvatar.textContent = (userName || 'U').split(' ').map(function(w){return w[0];}).join('').substring(0,2).toUpperCase();

    function typeLabel(t) { return TYPE_LABELS[t] || t || 'Appliance'; }
    function normalize(a) {
      if (!a) a = {};
      return {
        id: a.ID || a.id,
        name: a.Name || a.name || a.appliance_name || '',
        type: a.Type || a.type || a.appliance_type || '',
        make: a.Make || a.make || a.make_brand || a.brand || '',
        year: a.Year || a.year || a.year_model || ''
      };
    }

    var applianceSelect = document.getElementById('applianceSelect');
    var newApplianceFields = document.getElementById('newApplianceFields');
    applianceSelect.addEventListener('change', function() {
      newApplianceFields.style.display = (this.value === 'new') ? '' : 'none';
    });

    function loadAppliances() {
      fetch('../../controllers/customer/appliances.php?user_id=' + userId)
        .then(function(r){ return r.json(); })
        .then(function(data){
          var list = (data && data.appliances) || [];
          if (!Array.isArray(list)) list = [];
          allAppliances = list.map(normalize).filter(function(a){ return a.id; });
          allAppliances.forEach(function(a) {
            var opt = document.createElement('option');
            opt.value = a.id;
            var label = a.name || '';
            if (a.type) { if (label) label += ' — '; label += typeLabel(a.type); }
            if (a.make) label += ' (' + a.make + ')';
            if (a.year) label += ', ' + a.year;
            opt.textContent = label;
            applianceSelect.appendChild(opt);
          });
          if (!allAppliances.length) {
            applianceSelect.value = 'new';
            newApplianceFields.style.display = '';
          }
        })
        .catch(function(){ applianceSelect.value = 'new'; newApplianceFields.style.display = ''; });
    }
    loadAppliances();

    // === BOOKING LOCATION ===
    var bookingLocationStatusEl = document.getElementById('bookingLocationStatus');
    function bookingLocationReady() { return !!document.getElementById('bookingLat').value && !!document.getElementById('bookingLng').value; }
    function updateBookingLocationStatus() {
      if (bookingLocationReady()) {
        var addr = document.getElementById('bookingAddress').value;
        bookingLocationStatusEl.classList.remove('is-required');
        bookingLocationStatusEl.textContent = 'Location set: ' + (addr || document.getElementById('bookingLat').value + ', ' + document.getElementById('bookingLng').value);
      } else {
        bookingLocationStatusEl.classList.add('is-required');
        bookingLocationStatusEl.textContent = 'Please set your location before finding repairmen.';
      }
    }
    function initBookingPicker(initLat, initLng) {
      var had = !!(document.getElementById('bookingLat').value && document.getElementById('bookingLng').value);
      initLocationPicker({
        mapEl: 'bookingMap',
        latInput: 'bookingLat',
        lngInput: 'bookingLng',
        addressInput: 'bookingAddress',
        searchInput: 'bookingAddressSearch',
        deviceBtn: 'bookingLocateBtn',
        initialLat: initLat || 14.5995,
        initialLng: initLng || 120.9842,
        onSelect: function(){ updateBookingLocationStatus(); },
        onLocating: function(on){ if (bookingLocationStatusEl) bookingLocationStatusEl.textContent = on ? 'Fetching location...' : 'Location set.'; }
      });
      if (had) updateBookingLocationStatus();
    }

    // Prefill the booking location with the customer's registered location (may be updated on the map)
    fetch('../../controllers/customer/profile.php?user_id=' + userId)
      .then(function(r){ return r.json(); })
      .then(function(data){
        var d = (data && data.profile) || {};
        if (d.latitude && d.longitude) {
          document.getElementById('bookingLat').value = d.latitude;
          document.getElementById('bookingLng').value = d.longitude;
          document.getElementById('bookingAddress').value = d.formatted_address || '';
          initBookingPicker(d.latitude, d.longitude);
        } else {
          initBookingPicker(null, null);
        }
      })
      .catch(function(){ initBookingPicker(null, null); });

    // === FIND NEARBY REPAIRMEN ===
    var repairmanResultsSection = document.getElementById('repairmanResultsSection');
    var repairmanListEl = document.getElementById('repairmanList');
    var repairmanResultsHeader = document.getElementById('repairmanResultsHeader');
    var selectedRepairmanIdEl = document.getElementById('selectedRepairmanId');
    var selectedRepairmanDistEl = document.getElementById('selectedRepairmanDist');
    var selectedRepairmanDurEl = document.getElementById('selectedRepairmanDur');
    var selectedRepairmanDisplayEl = document.getElementById('selectedRepairmanDisplay');
    var findStatusEl = document.getElementById('findRepairmenStatus');
    var repairmanMapEl = document.getElementById('repairmanMap');
    var repairmanMapObj = null;
    var repairmanMarkers = [];
    var repairmanCards = [];
    var repairmanDataArr = [];
    var selectedIndex = -1;
    var hasSearchedRepairmen = false;
    var anyRepairmenFound = false;
    var directionsService = null;
    var directionsRenderer = null;
    var clientCenterGlobal = null;

    document.getElementById('findRepairmenBtn').addEventListener('click', function(){
      // validate form first
      var selected = applianceSelect.value;
      if (selected !== 'new' && selected !== '') { /* ok */ }
      else if (selected === 'new') {
        var at = document.getElementById('applianceType').value;
        var an = document.getElementById('applianceName').value;
        var mk = document.getElementById('makeBrand').value;
        var yr = document.getElementById('yearModel').value;
        if (!at || !an || !mk || !yr) { showAlert('Please fill in all appliance details before finding repairmen.', 'warning'); return; }
      } else { showAlert('Please select an appliance first.', 'warning'); return; }
      if (!document.getElementById('issueDesc').value) { showAlert('Please describe the issue.', 'warning'); return; }
      if (!document.getElementById('preferredDate').value || !document.getElementById('preferredTime').value) { showAlert('Please set a preferred date and time.', 'warning'); return; }
      if (!bookingLocationReady()) { showAlert('Please set your location before finding repairmen.', 'warning'); return; }

      var btn = this;
      btn.disabled = true;
      var origHtml = btn.innerHTML;
      btn.innerHTML = '<span class="spinner"></span> Searching...';
      findStatusEl.textContent = 'Searching nearby repairmen...';

      var radius = document.getElementById('searchRadius').value;
      var lat = document.getElementById('bookingLat').value;
      var lng = document.getElementById('bookingLng').value;
      fetch('../../controllers/customer/nearby-repairmen.php?user_id=' + userId + '&lat=' + encodeURIComponent(lat) + '&lng=' + encodeURIComponent(lng) + '&radius_km=' + encodeURIComponent(radius))
        .then(function(r){ return r.json(); })
        .then(function(data){
          btn.disabled = false;
          btn.innerHTML = origHtml;
          hasSearchedRepairmen = true;
          if (!data || data.status !== 'success') { findStatusEl.textContent = data && data.message ? data.message : 'Search failed.'; anyRepairmenFound = false; updateSubmitBookingState(); return; }
          findStatusEl.textContent = 'Found ' + (data.count || 0) + ' repairman' + ((data.count || 0) !== 1 ? 's' : '') + ' within ' + radius + ' km (' + (data.method === 'route' ? 'road distance' : 'estimated distance') + ').';
          selectedRepairmanIdEl.value = '';
          selectedRepairmanDistEl.value = '';
          selectedRepairmanDurEl.value = '';
          selectedRepairmanDisplayEl.textContent = 'None';
          selectedIndex = -1;
          anyRepairmenFound = (data.count || 0) > 0;
          renderRepairmanResults(data.repairmen || [], { lat: parseFloat(lat), lng: parseFloat(lng) });
          updateSubmitBookingState();
        })
        .catch(function(){ btn.disabled = false; btn.innerHTML = origHtml; findStatusEl.textContent = 'Network error.'; hasSearchedRepairmen = true; anyRepairmenFound = false; updateSubmitBookingState(); });
    });

    function renderRepairmanResults(repairmen, clientCenter) {
      repairmanDataArr = repairmen;
      clientCenterGlobal = clientCenter;
      repairmanResultsSection.style.display = '';
      repairmanResultsHeader.textContent = repairmen.length + ' Available Repairman' + (repairmen.length !== 1 ? 's' : '');
      if (!repairmanMapObj) {
        repairmanMapObj = new google.maps.Map(repairmanMapEl, {
          center: clientCenter,
          zoom: 13,
          mapTypeControl: false,
          streetViewControl: false
        });
        directionsService = new google.maps.DirectionsService();
        directionsRenderer = new google.maps.DirectionsRenderer({
          map: repairmanMapObj,
          suppressMarkers: true,
          polylineOptions: {
            strokeColor: '#2563eb',
            strokeOpacity: 0.8,
            strokeWeight: 4
          }
        });
      } else {
        repairmanMapObj.setCenter(clientCenter);
        repairmanMapObj.setZoom(13);
        if (directionsRenderer) {
          directionsRenderer.setMap(repairmanMapObj);
          directionsRenderer.setDirections(null);
        }
      }

      // clear old markers
      repairmanMarkers.forEach(function(m){ if (m.setMap) m.setMap(null); });
      repairmanMarkers = [];
      repairmanListEl.innerHTML = '';
      repairmanCards = [];

      // client marker
      var clientMarker = new google.maps.Marker({
        position: clientCenter,
        map: repairmanMapObj,
        title: 'Your location',
        icon: { path: google.maps.SymbolPath.CIRCLE, scale: 10, fillColor: '#1d4ed8', fillOpacity: 1, strokeColor: '#ffffff', strokeWeight: 2 }
      });
      repairmanMarkers.push(clientMarker);

      if (!repairmen.length) {
        repairmanListEl.innerHTML = '<div style="padding:20px;color:var(--muted);">No repairmen found within the selected radius. Try increasing your search radius.</div>';
        return;
      }

      repairmen.forEach(function(r, idx) {
        var pos = { lat: parseFloat(r.Latitude), lng: parseFloat(r.Longitude) };
        var marker = new google.maps.Marker({
          position: pos,
          map: repairmanMapObj,
          title: r.Name || 'Repairman'
        });
        repairmanMarkers.push(marker);

        var rating = parseFloat(r.Ratings || 0) || 0;
        var stars = '';
        for (var s = 1; s <= 5; s++) stars += s <= Math.round(rating) ? '&#9733;' : '&#9734;';
        var skills = (r.Skills || '').split(',').map(function(x){ return x.trim(); }).filter(Boolean).slice(0, 3).join(', ');
        var certs = '';
        try {
          var certArr = JSON.parse(r.Certifications || '[]');
          certs = Array.isArray(certArr) ? certArr.length : 0;
        } catch(e) { certs = 0; }

        var infoHtml = '<div style="min-width:220px;max-width:300px;font-family:Inter,system-ui,sans-serif;font-size:13px;">' +
          '<div style="font-weight:800;font-size:1.05rem;margin-bottom:4px;">' + escHtml(r.Name || '') + '</div>' +
          '<div style="color:#f59e0b;margin-bottom:4px;font-size:0.95rem;">' + stars + ' <span style="color:#6b7280;font-size:0.82rem;">(' + rating.toFixed(1) + ')</span></div>' +
          '<div style="color:#374151;margin-bottom:3px;">&#128205; ' + (r.distance_km != null ? r.distance_km + ' km' : '') + (r.duration_min != null ? ' (~' + r.duration_min + ' min)' : '') + '</div>' +
          '<div style="color:#6b7280;margin-bottom:3px;">Completed repairs: ' + (r.CompletedRepairs || 0) + '</div>' +
          (skills ? '<div style="color:#6b7280;margin-bottom:3px;">Skills: ' + escHtml(skills) + '</div>' : '') +
          (certs ? '<div style="color:#6b7280;margin-bottom:3px;">Certificates: ' + certs + '</div>' : '') +
          '<div style="margin-top:8px;"><button onclick="window._selectRepairmanFromMap(' + idx + ');" style="padding:6px 14px;background:#2563eb;color:#fff;border:0;border-radius:6px;font-size:0.85rem;font-weight:600;cursor:pointer;">Select</button></div>' +
          '</div>';

        var infoWindow = new google.maps.InfoWindow({ content: infoHtml });
        marker.addListener('click', function(){
          infoWindow.open(repairmanMapObj, marker);
        });

        // Card in sidebar list
        var card = document.createElement('div');
        card.className = 'repairman-card';
        card.style.cssText = 'border:1px solid #e5e7eb;border-radius:10px;padding:14px;margin-bottom:12px;cursor:pointer;background:#fff;';
        card.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:start;">' +
          '<div><div style="font-weight:700;color:#111827;font-size:1rem;">' + escHtml(r.Name || '') + '</div>' +
          '<div style="color:#f59e0b;font-size:0.9rem;margin:3px 0;">' + stars + ' <span style="color:#6b7280;font-size:0.82rem;">' + rating.toFixed(1) + '</span></div>' +
          '<div style="color:#4b5563;font-size:0.85rem;margin-bottom:4px;">&#128205; ' + (r.distance_km != null ? r.distance_km + ' km' : '—') + (r.duration_min != null ? ' (~' + r.duration_min + ' min drive)' : '') + '</div>' +
          '<div style="color:#6b7280;font-size:0.82rem;">Completed repairs: ' + (r.CompletedRepairs || 0) + '</div>' +
          (skills ? '<div style="color:#6b7280;font-size:0.82rem;margin-top:3px;">Skills: ' + escHtml(skills) + '</div>' : '') +
          (certs ? '<div style="color:#6b7280;font-size:0.82rem;">Certificates: ' + certs + '</div>' : '') +
          '</div>' +
          '<div style="text-align:right;"><div style="font-size:0.82rem;color:#6b7280;margin-bottom:6px;">' + (r.route_used ? 'Road distance' : 'Est. distance') + '</div>' +
          '<button class="select-repairman-btn" style="padding:6px 12px;background:#2563eb;color:#fff;border:0;border-radius:6px;font-size:0.82rem;font-weight:600;cursor:pointer;">Select</button>' +
          '</div></div>';

        (function(idx, marker){
          card.addEventListener('click', function(){ selectRepairman(idx); });
          card.querySelector('.select-repairman-btn').addEventListener('click', function(e){ e.stopPropagation(); selectRepairman(idx); });
          card.addEventListener('mouseenter', function(){ marker.setAnimation(google.maps.Animation.BOUNCE); });
          card.addEventListener('mouseleave', function(){ marker.setAnimation(null); });
        })(idx, marker);

        repairmanListEl.appendChild(card);
        repairmanCards.push(card);
      });

      window._selectRepairmanFromMap = function(idx){ selectRepairman(idx); };
    }

    function selectRepairman(idx) {
      var r = repairmanDataArr[idx];
      if (!r) return;
      selectedIndex = idx;
      selectedRepairmanIdEl.value = r.ID || '';
      selectedRepairmanDistEl.value = r.distance_km != null ? r.distance_km : '';
      selectedRepairmanDurEl.value = r.duration_min != null ? r.duration_min : '';
      var rating = parseFloat(r.Ratings || 0) || 0;
      var stars = '';
      for (var s = 1; s <= 5; s++) stars += s <= Math.round(rating) ? '&#9733;' : '&#9734;';
      selectedRepairmanDisplayEl.innerHTML = escHtml(r.Name || '') + ' <span style="font-weight:400;color:#f59e0b;">' + stars + '</span> <span style="font-weight:400;color:var(--muted);font-size:0.85rem;">' + (r.distance_km != null ? r.distance_km + ' km' : '') + (r.duration_min != null ? ' (~' + r.duration_min + ' min)' : '') + '</span>';
      repairmanCards.forEach(function(c, i){ c.style.borderColor = i === idx ? '#2563eb' : '#e5e7eb'; c.style.boxShadow = i === idx ? '0 0 0 2px rgba(37,99,235,0.18)' : 'none'; });
      if (repairmanMarkers[idx+1]) { repairmanMapObj.panTo(repairmanMarkers[idx+1].getPosition()); }
      
      // Draw route from customer to selected repairman
      if (directionsService && directionsRenderer && clientCenterGlobal) {
        directionsService.route({
          origin: clientCenterGlobal,
          destination: { lat: parseFloat(r.Latitude), lng: parseFloat(r.Longitude) },
          travelMode: google.maps.TravelMode.DRIVING
        }, function(result, status) {
          if (status === google.maps.DirectionsStatus.OK) {
            directionsRenderer.setDirections(result);
          }
        });
      }
      
      updateSubmitBookingState();
    }

    function escHtml(s) {
      var d = document.createElement('div');
      d.appendChild(document.createTextNode(s));
      return d.innerHTML;
    }

    // === BOOKING MEDIA: 3 PHOTOS + 1 VIDEO ===
    var bookingMedia = { img1: null, img2: null, img3: null, vid: null };

    function compressImage(file, maxDim, quality) {
      return new Promise(function(resolve, reject) {
        var img = new Image();
        var url = URL.createObjectURL(file);
        img.onload = function() {
          URL.revokeObjectURL(url);
          var scale = Math.min(1, maxDim / Math.max(img.width, img.height));
          var w = Math.round(img.width * scale);
          var h = Math.round(img.height * scale);
          var canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          var ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, w, h);
          canvas.toBlob(function(blob) {
            if (!blob) return reject(new Error('Compression failed'));
            blob.name = file.name;
            resolve(blob);
          }, 'image/jpeg', quality);
        };
        img.onerror = function() { URL.revokeObjectURL(url); reject(new Error('Invalid image')); };
        img.src = url;
      });
    }

    function handleImagePicked(file, slot) {
      if (!file) return;
      var slotEl = document.querySelector('#' + (slot === 'img1' ? 'imgSlot1' : slot === 'img2' ? 'imgSlot2' : 'imgSlot3') + ' .hs-media-preview');
      compressImage(file, 1280, 0.7).then(function(blob) {
        bookingMedia[slot] = blob;
        var thumb = URL.createObjectURL(blob);
        if (slotEl) {
          slotEl.innerHTML = '<img src="' + thumb + '" style="width:100%;height:100%;object-fit:cover;display:block;"><button type="button" class="hs-media-remove" data-slot="' + slot + '" title="Remove" style="position:absolute;top:6px;right:6px;background:rgba(239,68,68,0.95);border:0;color:#fff;width:22px;height:22px;border-radius:50%;cursor:pointer;font-size:0.9rem;line-height:1;">&times;</button>';
        }
        updateMediaStatus();
      }).catch(function(){ showAlert('Could not process that photo. Try a different image.', 'error'); });
    }

    function handleVideoPicked(file) {
      if (!file) return;
      if (!/^video\//.test(file.type)) { showAlert('Please select a video file.', 'error'); return; }
      bookingMedia.vid = file;
      var slotEl = document.querySelector('#vidSlot .hs-media-preview');
      var url = URL.createObjectURL(file);
      if (slotEl) {
        slotEl.innerHTML = '<video src="' + url + '" style="width:100%;height:100%;object-fit:cover;" muted></video><button type="button" class="hs-media-remove" data-slot="vid" title="Remove" style="position:absolute;top:6px;right:6px;background:rgba(239,68,68,0.95);border:0;color:#fff;width:22px;height:22px;border-radius:50%;cursor:pointer;font-size:0.9rem;line-height:1;">&times;</button>';
      }
      updateMediaStatus();
    }

    function updateMediaStatus() {
      var haveImg = [bookingMedia.img1, bookingMedia.img2, bookingMedia.img3].filter(Boolean).length;
      var el = document.getElementById('mediaStatus');
      if (!el) return;
      el.innerHTML = haveImg + '/3 photos' + (bookingMedia.vid ? ' and video recorded' : ' (video pending)') +
        (haveImg < 3 || !bookingMedia.vid ? ' <span style="color:#ef4444;">Required: 3 photos + 1 video.</span>' : ' <span style="color:#22c55e;">Complete.</span>');
    }

    document.querySelectorAll('.hs-cam-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var input = document.querySelector('.hs-img-input[data-slot="' + btn.getAttribute('data-slot') + '"]');
        if (input) { input.setAttribute('capture', 'environment'); input.click(); }
      });
    });
    document.querySelectorAll('.hs-file-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var input = document.querySelector('.hs-img-input[data-slot="' + btn.getAttribute('data-slot') + '"]');
        if (input) { input.removeAttribute('capture'); input.click(); }
      });
    });
    document.querySelectorAll('.hs-img-input').forEach(function(input) {
      input.addEventListener('change', function() { handleImagePicked(this.files && this.files[0], this.getAttribute('data-slot')); });
      this.value = '';
    });
    var vidCamBtn = document.querySelector('.hs-vid-cam-btn');
    if (vidCamBtn) vidCamBtn.addEventListener('click', function() {
      var input = document.querySelector('.hs-vid-input');
      if (input) { input.setAttribute('capture', 'environment'); input.click(); }
    });
    var vidFileBtn = document.querySelector('.hs-vid-file-btn');
    if (vidFileBtn) vidFileBtn.addEventListener('click', function() {
      var input = document.querySelector('.hs-vid-input');
      if (input) { input.removeAttribute('capture'); input.click(); }
    });
    var vidInput = document.querySelector('.hs-vid-input');
    if (vidInput) vidInput.addEventListener('change', function() { handleVideoPicked(this.files && this.files[0]); this.value = ''; });

    document.addEventListener('click', function(e) {
      var rm = e.target.closest('.hs-media-remove');
      if (!rm) return;
      var slot = rm.getAttribute('data-slot');
      bookingMedia[slot] = null;
      var slotId = slot === 'vid' ? 'vidSlot' : 'imgSlot' + slot.slice(3);
      var slotEl = document.getElementById(slotId);
      if (slotEl) {
        var preview = slotEl.querySelector('.hs-media-preview');
        if (preview) {
          preview.innerHTML = '<div class="hs-media-empty">' + (slot === 'vid' ? '&#127909;<br><span style="font-size:0.78rem;color:var(--muted);">Video (short)</span>' : '&#128247;<br><span style="font-size:0.78rem;color:var(--muted);">Photo ' + slot.slice(3) + '</span>') + '</div>';
        }
        var input = slotEl.querySelector('input[type="file"]');
        if (input) input.value = '';
      }
      updateMediaStatus();
    });

    updateMediaStatus();

    function updateSubmitBookingState() {
      var btn = document.getElementById('submitBookingBtn');
      var repairmanId = selectedRepairmanIdEl.value;
      if (!hasSearchedRepairmen) {
        btn.disabled = true;
        btn.title = 'Please find nearby repairmen first.';
        return;
      }
      if (!anyRepairmenFound) {
        btn.disabled = true;
        btn.title = 'No repairmen are currently available. Please try again later or increase your search radius.';
        return;
      }
      if (!repairmanId) {
        btn.disabled = true;
        btn.title = 'Please select a repairman from the list.';
        return;
      }
      btn.disabled = false;
      btn.title = '';
    }

    window.handleSubmitBookingClick = function() {
      // 1. Validate appliance
      var selected = applianceSelect.value;
      if (selected === '') {
        showAlert('Please select an appliance or choose "Add a new / other appliance".', 'warning');
        return;
      }
      if (selected === 'new') {
        var at = document.getElementById('applianceType').value;
        var an = document.getElementById('applianceName').value;
        var mk = document.getElementById('makeBrand').value;
        var yr = document.getElementById('yearModel').value;
        if (!at) { showAlert('Please select an appliance type.', 'warning'); return; }
        if (!an) { showAlert('Please enter the appliance name.', 'warning'); return; }
        if (!mk) { showAlert('Please enter the make / brand.', 'warning'); return; }
        if (!yr) { showAlert('Please enter the year.', 'warning'); return; }
      }

      // 2. Validate issue
      if (!document.getElementById('issueDesc').value.trim()) {
        showAlert('Please describe the issue with your appliance.', 'warning');
        return;
      }

      // 3. Validate date & time
      if (!document.getElementById('preferredDate').value) {
        showAlert('Please select a preferred date.', 'warning');
        return;
      }
      if (!document.getElementById('preferredTime').value) {
        showAlert('Please select a preferred time.', 'warning');
        return;
      }

      // 4. Validate location
      if (!bookingLocationReady()) {
        showAlert('Please set your location on the map before submitting.', 'warning');
        return;
      }

      // 5. Validate repairman search
      if (!hasSearchedRepairmen) {
        showAlert('Please find nearby repairmen before submitting a booking. Use the "Find Nearby Repairmen" button above.', 'warning');
        return;
      }
      if (!anyRepairmenFound) {
        showAlert('No repairmen are currently available in your area. Try increasing your search radius or check back later.', 'error');
        return;
      }

      // 6. Validate repairman selection
      if (!selectedRepairmanIdEl.value) {
        showAlert('Please select a repairman from the available list above before submitting your booking.', 'warning');
        return;
      }

      // 7. Validate booking media (3 photos + 1 video required)
      if (!bookingMedia.img1 || !bookingMedia.img2 || !bookingMedia.img3) {
        showAlert('Please capture or upload all 3 required photos of the appliance issue.', 'warning');
        return;
      }
      if (!bookingMedia.vid) {
        showAlert('Please capture or upload the required short video of the appliance issue.', 'warning');
        return;
      }

      openModal('confirmBookingModal');
    };

    // === SUBMIT BOOKING ===
    document.getElementById('confirmBtn').addEventListener('click', function() {
      var selected = applianceSelect.value;
      var applianceType, applianceName, makeBrand, yearModel, applianceId = null;
      if (selected === 'new') {
        applianceType = document.getElementById('applianceType').value;
        applianceName = document.getElementById('applianceName').value;
        makeBrand = document.getElementById('makeBrand').value;
        yearModel = document.getElementById('yearModel').value;
      } else {
        var a = allAppliances.find(function(x){ return String(x.id) === String(selected); });
        if (a) {
          applianceId = a.id;
          applianceType = a.type;
          applianceName = a.name;
          makeBrand = a.make;
          yearModel = a.year;
        }
      }
      var issueDesc = document.getElementById('issueDesc').value;
      var preferredDate = document.getElementById('preferredDate').value;
      var preferredTime = document.getElementById('preferredTime').value;
      var repairmanId = selectedRepairmanIdEl.value;

      var fd = new FormData();
      fd.append('action', 'book');
      fd.append('user_id', userId);
      fd.append('appliance_type', applianceType);
      fd.append('appliance_name', applianceName);
      fd.append('make_brand', makeBrand);
      fd.append('year_model', yearModel);
      if (applianceId) fd.append('appliance_id', applianceId);
      fd.append('issue_desc', issueDesc);
      fd.append('detailed_report', document.getElementById('detailedReport').value.trim());
      fd.append('preferred_date', preferredDate);
      fd.append('preferred_time', preferredTime);
      fd.append('repairman_id', repairmanId);
      fd.append('client_lat', document.getElementById('bookingLat').value);
      fd.append('client_lng', document.getElementById('bookingLng').value);
      fd.append('route_distance_km', selectedRepairmanDistEl.value);
      fd.append('route_duration_min', selectedRepairmanDurEl.value);
      // Append booking media (3 images + 1 video)
      if (bookingMedia.img1) fd.append('image_1', bookingMedia.img1, 'photo1.jpg');
      if (bookingMedia.img2) fd.append('image_2', bookingMedia.img2, 'photo2.jpg');
      if (bookingMedia.img3) fd.append('image_3', bookingMedia.img3, 'photo3.jpg');
      if (bookingMedia.vid) fd.append('video', bookingMedia.vid);
      fetch('../../controllers/customer/tickets.php', { method: 'POST', body: fd })
        .then(function(r){ return r.json(); })
        .then(function(data){
          if (isSuccess(data)) {
            closeModal('confirmBookingModal');
            openModal('successBookingModal');
          } else {
            showAlert(data.message || 'Error submitting booking.', 'error');
          }
        })
        .catch(function(){ showAlert('Network error. Please try again.', 'error'); });
    });

    document.getElementById('logoutBtn').addEventListener('click', function() {
      fetch('../../controllers/logout.php', { method: 'POST' })
        .then(function(){ localStorage.clear(); window.location.href = 'landing-page.html'; })
        .catch(function(){ localStorage.clear(); window.location.href = 'landing-page.html'; });
    });

    updateSubmitBookingState();
  })();
  </script>
</body>
</html>
